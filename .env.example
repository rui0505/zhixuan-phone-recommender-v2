# Optional model integration is OFF. Manual catalog/TOPSIS needs no key.
# Do not enable a public shared key before separately approving budget and
# verifying billing/rate limits on a managed gateway. These flags are NOT a limiter.
PHONE_ENABLE_LLM=false
PHONE_LLM_BUDGET_APPROVED=false
PHONE_LLM_GATEWAY_LIMITS_APPROVED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional persistent state. The management key is randomly generated beside the
# feedback database and is shared by phone intake and feedback moderation.
# PHONE_FEEDBACK_DB=/var/lib/zhixuan/feedback.sqlite3
# PHONE_CATALOG_STATE=/var/lib/zhixuan/catalog
# PHONE_ADMIN_TOKEN=     # Optional legacy X-Intake-Token; never commit a real key.
