# Streamlit 密钥配置模板。
#
# 复制为 secrets.toml 并填入真实值。secrets.toml 已在 .gitignore 中，
# 不会被提交。密钥只放这里或环境变量，禁止写进代码、日志或提交历史。
#
# app.py 启动时会把这里的 LLM_* 搬进环境变量（providers.llm 只读环境变量）。
# 环境变量优先：若已经设了同名环境变量，这里的值不会覆盖它。
#
# 本地开发也可以完全不用这个文件，直接设环境变量即可，见 .env.example。
#
# 支持的供应商（任何 OpenAI 兼容的 /chat/completions 端点都行）：
#   DeepSeek      https://api.deepseek.com/v1                        deepseek-flash
#   通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4               glm-4-flash
#   月之暗面      https://api.moonshot.cn/v1                         moonshot-v1-8k
#   本地 Ollama   http://localhost:11434/v1                          qwen2.5:7b
#
# ⚠️ DeepSeek 的 `deepseek-chat` 是**遗留名**，请求仍会被受理，但实际由
#    DeepSeek-V4.1-Flash 提供服务并按 Flash 计价。当前可用名是 `deepseek-flash`
#    与 `deepseek-v4-pro`。
#
# 优先级：真实环境变量 > .env > 本文件。三者都是「只填不覆盖」。

LLM_BASE_URL = "https://api.deepseek.com/v1"
LLM_MODEL = "deepseek-flash"
LLM_API_KEY = ""
